# data
datasets/*
!datasets/.gitkeep
models/*
!models/.gitkeep

# editor
.vscode

# python
.venv
uv.lock
uv.toml
*.egg-info/
*.egg
__pycache__/
*.pyc
*.pyo
dist/

# Local comparison material and disposable verification outputs.
/tmp/
/.tmp_tests/
.tmp_mne_home/
.tmp_uv_cache/

# recorded runs and generated outputs (keep the folders, not their content)
records/*
!records/.gitkeep
results/*
!results/.gitkeep

# macOS metadata. On exFAT (this repository lives on one) macOS cannot store
# extended attributes, so it writes an AppleDouble sidecar next to every file it
# creates: "._relay.py" beside "relay.py". Those are metadata, not content, and
# they otherwise sweep into `git add -A` by the hundred.
._*
.DS_Store
__MACOSX/
